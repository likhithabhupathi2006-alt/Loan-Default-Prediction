def show_dashboard(model, model_name, X_test, y_test):

    import matplotlib.pyplot as plt
    import numpy as np
    from sklearn.metrics import (
        confusion_matrix, accuracy_score, precision_score,
        recall_score, f1_score, roc_curve, roc_auc_score
    )

    y_pred = model.predict(X_test)

    if hasattr(model, "predict_proba"):
        y_prob = model.predict_proba(X_test)[:,1]
    else:
        y_prob = model.predict(X_test)

    # ======================
    # METRICS
    # ======================
    cm = confusion_matrix(y_test, y_pred)
    TN, FP, FN, TP = cm.ravel()
    total = cm.sum()

    accuracy = accuracy_score(y_test, y_pred)
    precision = precision_score(y_test, y_pred)
    recall = recall_score(y_test, y_pred)
    f1 = f1_score(y_test, y_pred)

    fpr, tpr, _ = roc_curve(y_test, y_prob)
    auc_score = roc_auc_score(y_test, y_prob)

    # ======================
    # FIGURE
    # ======================
    fig = plt.figure(figsize=(16,9))
    fig.patch.set_facecolor("white")

    fig.suptitle(f"{model_name.upper()} MODEL EVALUATION",
                 fontsize=20, weight='bold')

    # ======================
    # PIE (LEFT TOP)
    # ======================
    ax1 = plt.subplot2grid((3,4),(0,0), colspan=2)

    values = [TP, FP, FN, TN]
    labels = ['TP','FP','FN','TN']
    colors = ['#4CAF50','#F44336','#FF9800','#2196F3']

    wedges, _, _ = ax1.pie(
        values,
        autopct='%1.1f%%',
        startangle=130,
        colors=colors,
        wedgeprops={'edgecolor':'white'}
    )

    ax1.legend(wedges, labels, loc='center left', bbox_to_anchor=(1,0.5))
    ax1.set_title("Confusion Matrix (%)", fontsize=12)

    # ======================
    # TABLE (RIGHT TOP)
    # ======================
    ax2 = plt.subplot2grid((3,4),(0,2), colspan=2)
    ax2.axis('off')

    table = ax2.table(
        cellText=[[TP, FN],[FP, TN]],
        rowLabels=['Actual +','Actual -'],
        colLabels=['Pred +','Pred -'],
        loc='center'
    )

    table.auto_set_font_size(False)
    table.set_fontsize(11)
    table.scale(1,1.5)

    ax2.set_title("Confusion Matrix (Values)", fontsize=12)

    # ======================
    # METRIC CARDS
    # ======================
    metrics = [accuracy, precision, recall, f1]
    names = ["Accuracy", "Precision", "Recall", "F1 Score"]
    colors_bar = ['#4CAF50','#F44336','#FF9800','#2196F3']

    for i in range(4):
        ax = plt.subplot2grid((3,4),(1,i))

        ax.barh([0], [metrics[i]], color=colors_bar[i], height=0.5)
        ax.set_xlim(0,1)
        ax.set_yticks([])

        ax.set_title(f"{names[i]}\n{metrics[i]:.2%}", fontsize=11)

        for spine in ax.spines.values():
            spine.set_visible(False)

    # ======================
    # BAR COMPARISON
    # ======================
    ax3 = plt.subplot2grid((3,4),(2,0), colspan=2)

    bars = ax3.bar(names, metrics, color=colors_bar)

    for bar,val in zip(bars, metrics):
        ax3.text(bar.get_x()+bar.get_width()/2,
                 val+0.02,
                 f"{val:.2%}",
                 ha='center', fontsize=9)

    ax3.set_ylim(0,1)
    ax3.set_title("Metrics Comparison", fontsize=12)

    ax3.spines[['top','right']].set_visible(False)

    # ======================
    # ROC CURVE
    # ======================
    ax4 = plt.subplot2grid((3,4),(2,2), colspan=2)

    ax4.plot(fpr, tpr, linewidth=2, label=f"AUC = {auc_score:.2f}")
    ax4.plot([0,1],[0,1],'--', color='gray')

    ax4.set_xlabel("FPR")
    ax4.set_ylabel("TPR")
    ax4.set_title("ROC Curve", fontsize=12)
    ax4.legend()

    # ======================
    # FINAL TOUCH
    # ======================
    plt.tight_layout(rect=[0,0,1,0.95])
    plt.show()
