for i, metric in enumerate(metrics):
    plt.bar(x + i*width, results_df[metric], width, label=metric)

plt.xticks(x + width, results_df["Model"], rotation=15)
plt.ylim(0,1)

plt.title("Model Performance Comparison", fontsize=14, weight='bold')
plt.ylabel("Score")
plt.legend()

plt.tight_layout()
plt.show()
