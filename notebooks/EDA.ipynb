# ======================
# IMPORT LIBRARIES
# ======================
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ======================
# LOAD DATA
# ======================
try:
    df = pd.read_csv('../data/loan_data_small.csv')
except FileNotFoundError:
    print("Dataset not found. Please download and place it in data/ folder.")
# ======================
# BASIC INFO
# ======================
print("Shape:", df.shape)
print("\nInfo:\n")
df.info()

print("\nMissing Values:\n")
print(df.isnull().sum())

# ======================
# TARGET DISTRIBUTION
# ======================
plt.figure()
sns.countplot(x='Status', data=df)
plt.title("Loan Status Distribution")
plt.show()

# ======================
# HISTOGRAMS
# ======================
plt.figure()
df['income'].hist()
plt.title("Income Distribution")
plt.show()

plt.figure()
df['loan_amount'].hist()
plt.title("Loan Amount Distribution")
plt.show()

# ======================
# CORRELATION HEATMAP
# ======================
plt.figure(figsize=(10,8))
sns.heatmap(df.corr(numeric_only=True), cmap='coolwarm')
plt.title("Correlation Heatmap")
plt.show()
